#!/usr/bin/env bash
# Show how extension providers are registered and which source files define them.
# Requires: ripgrep (rg), tsx (workspace dev dependency)
set -euo pipefail
cd "$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"

ext=packages/vscode-better-zsh

echo "=== Provider registrations ($ext/src/contributions.ts) ==="
node - <<NODE
const { readFileSync } = require("node:fs")
const src = readFileSync("$ext/src/contributions.ts", "utf8")
const re = /languages\.(register\w+Provider)\(/g

for (const match of src.matchAll(re)) {
  let depth = 1
  let i = match.index + match[0].length
  for (; i < src.length && depth > 0; i++) {
    if (src[i] === "(") depth++
    if (src[i] === ")") depth--
  }
  const call = src.slice(match.index + match[0].length, i)
  const provider = call.match(/\b(?:new\s+)?(\w+Provider)\b/)?.[1]
  if (provider) console.log(\`  \${match[1]} -> \${provider}\`)
}
NODE

echo ""
echo "=== Provider classes ==="
rg 'class \w+Provider' --type ts "$ext/src/" 2>/dev/null || echo "  (none found)"

echo ""
echo "=== Manifest contribution points ($ext/src/manifest.ts) ==="
(cd "$ext" && pnpm exec tsx --eval '
  import { manifest } from "./src/manifest"
  const { semanticTokenScopes, ...rest } = manifest.contributes
  console.log("  " + Object.keys(rest).join(", "))
  console.log("  semanticTokenScopes: " + JSON.stringify(semanticTokenScopes))
')
