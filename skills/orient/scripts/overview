#!/usr/bin/env zsh
# Emit a compact, always-fresh structural overview of the monorepo.
# Intended to be run by an agent at the start of a work session.

emulate -LR zsh
set -eu -o pipefail

me=${0:t}
me_dir=${0:A:h}

help="
Usage:
  $me [zsh-core|zsh-core-tooldef|zshref-mcp|vscode-better-zsh|zshref-rs]...

Print the repo overview. With subpackage args, also print file trees for those
packages.
"

section() print "\n=== $1 ==="
msg    () print -u2 -- "$me: $@"
die    () { msg "ERROR: $@ (see --help)" && exit 1; }

list-nonignored-files() git ls-files --cached --others --exclude-standard

tree_() {
  local dirs=( $@ )
  local args=( -a -F --noreport --prune --compress=3 --gitignore --filesfirst )
  print "\n\$ tree $args $dirs\n"
  tree $args $dirs
}

dirs_ts=()
dirs_rs=()
foreach arg ( $@ ) {
  case $arg in
       (-h|--help        ) print -r -- $help && exit 0
    ;;
       (zsh-core         ) dirs_ts+=( packages/zsh-core          )
    ;; (zsh-core-tooldef ) dirs_ts+=( packages/zsh-core-tooldef  )
    ;; (zshref-mcp       ) dirs_ts+=( packages/zshref-mcp        )
    ;; (vscode-better-zsh) dirs_ts+=( packages/vscode-better-zsh )
    ;; (zshref-rs        ) dirs_rs+=( zshref-rs                  )
    ;; (*                ) die "illegal arg: $arg"
    ;;
  esac
}


cd "$(git -C $me_dir rev-parse --show-toplevel)"


# --- print sections ---

section 'maintainer docs'
print
print '$ ./scripts/list-maintainer-docs'
print
./scripts/list-maintainer-docs
print

section 'packages/projects manifests'
print
list-nonignored-files \
| grep -E 'pnpm-workspace.yaml|package.json|deno.json|Cargo.toml|Makefile'
print

() {
  local glob='*/dist/types/*.d.ts'
  local matches
  section "rolled-up public APIs with JSDoc ($glob)"
  print
  matches=$(find packages -type f -path $glob -not -path '*/node_modules/*' | sort)
  [[ -n $matches ]] && print -r -- $matches || print '(not built — run the relevant package build)'
  print
}

section 'repo symlinks'
print
print '$ ./scripts/list-repo-symlinks'
print
./scripts/list-repo-symlinks

() {
  section 'file trees'
  print
  if (( $#dirs_ts || $#dirs_rs ))
  then
    local d
    foreach d ($dirs_ts) { tree_                  $d; }
    foreach d ($dirs_rs) { tree_ -I '**/target/*' $d; }
  else
    print -l \
      'only printed when requested explicitly' \
      '(tree -> not grep-friendly)' \
      'examples:' \
      "  $me zsh-core" \
      "  $me zsh-core-tooldef" \
      "  $me zshref-mcp" \
      "  $me vscode-better-zsh" \
      "  $me zshref-rs" \
      "  $me zsh-core zsh-core-tooldef"
  fi
  print
}
