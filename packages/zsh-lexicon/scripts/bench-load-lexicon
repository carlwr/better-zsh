#!/bin/sh
# Cold full-lexicon load timings: loadLexicon() plus a read of every category
# (loading is lazy per category, so the call alone measures nothing). N fresh
# node processes (default 10). Prints sorted per-run ms plus summary stats.
# Requires dist/ to be built.
#
# Usage: scripts/bench-load-lexicon [N]
set -eu
N=${1:-10}
cd "$(dirname "$0")/.."
for _ in $(seq "$N"); do
  node --input-type=module -e "const t0=performance.now(); const m=await import('./dist/index.mjs'); const c=m.loadLexicon(); for (const k of Object.keys(c)) c[k]; console.log((performance.now()-t0).toFixed(2))"
done | sort -n | awk '{ print; a[NR]=$1; s+=$1 } END { printf "---\nN=%d mean=%.2fms min=%s median=%s max=%s\n", NR, s/NR, a[1], a[int((NR+1)/2)], a[NR] }'
