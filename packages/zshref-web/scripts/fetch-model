#! /usr/bin/env zsh
emulate -LR zsh
set -eu -o pipefail
zmodload zsh/stat
#
# Download the BGE-small ONNX model + tokenizer files into .aux/model/ (this
# package; gitignored) — the one input not reproducible from this repo.

me=${0:t}
webDir=${0:A:h:h}
dst=$webDir/.aux/model

# = MODEL_ID and MODEL_REVISION (nlp/core/types.ts; a test checks both): the
# browser loads the same commit, so the index and the queries share weights.
repo=BAAI/bge-small-en-v1.5
rev=5c38ec7c405ec4b44b94cc5a9bb96e735b38267a

# The revision the files in $dst came from; a file at the right size but from
# another revision is fetched again.
stamp=$dst/.revision

# <path>:<bytes>. The revision pins the content; the size catches a
# truncated or interrupted download.
# `onnx/model.onnx` plus the four tokenizer files are what transformers.js
# loads in local-models mode (nlp/node/embedder-node.ts).
files=(
  onnx/model.onnx:133093490
  tokenizer.json:711396
  config.json:743
  special_tokens_map.json:125
  tokenizer_config.json:366
)

help="
Download the local NLP model into packages/zshref-web/.aux/model/ (~127M).

Idempotent: a file already present from the pinned revision, at its size, is
left alone.

USAGE:
  $me [--help]

THEN:
  pnpm --filter zshref-web build:index   # the index (minutes on CPU); reporters build it in memory without
  pnpm --filter zshref-web test          # the model- and index-gated tests now run instead of skipping
"

msg() { print -u2 -- "$me: $@" }
die() {
  msg "ERROR: $1" ; shift
  for hint in "$@" ; do msg "       $hint" ; done
  exit 1
}
size-of() { zstat -L +size $1 2>/dev/null || print 0 }

(( $# <= 1 )) || die "too many arguments" "usage: $me --help"
case ${1-} in
  ("")        ;;
  (-h|--help) print -- $help ; exit 0 ;;
  (*)         die "unknown argument: $1" "usage: $me --help" ;;
esac

(( $+commands[curl] )) \
  || die "curl not found" "install curl, or place $repo files under $dst by hand"

haveRev=
[[ -f $stamp ]] && haveRev=$(<$stamp)
[[ $haveRev == $rev ]] || rm -f $stamp  # written once every file is at $rev

for entry in $files ; do
  rel=${entry%:*}
  want=${entry##*:}
  out=$dst/$rel
  if [[ $haveRev == $rev && -f $out ]] && (( $(size-of $out) == want )) ; then
    msg "have  $rel"
    continue
  fi
  mkdir -p ${out:h}
  msg "fetch $rel ($want bytes)"
  curl -fSL --retry 3 -o $out.tmp "https://huggingface.co/$repo/resolve/$rev/$rel" \
    || { rm -f $out.tmp ; die "download failed: $rel" "check network access to huggingface.co" }
  got=$(size-of $out.tmp)
  (( got == want )) \
    || { rm -f $out.tmp
         die "size mismatch for $rel: got $got, want $want" \
             "if the pinned revision moved, update rev/sizes in $me" }
  mv $out.tmp $out
done

[[ $haveRev == $rev ]] || print -r -- $rev > $stamp
msg "model → $dst"
