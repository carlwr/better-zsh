{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "root": false,
  "extends": "//",
  "files": {
    "includes": [
      "**",
      // Committed generated JSON (the `UPDATE_*` tests regenerate it in
      // their own layout): drift-checked, not formatted; one file exceeds
      // Biome's size cap.
      "!nlp/data",
      "!nlp/rules/schema"
    ]
  },
  // .svelte: formatted (the <script> blocks), not linted — svelte-check owns
  // them (template-aware); Biome parses <script> in isolation and would
  // false-flag template-referenced symbols as unused.
  "linter": {
    "includes": ["**", "!**/*.svelte"]
  }
}
