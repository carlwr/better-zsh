{
  "name": "zshref-web",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Static SPA: NLP search demo over zsh-core records.",
  "license": "MIT",
  "scripts": {
    "prebuild": "node ../../scripts/build/upstream-ready.mjs ensure",
    "prebuild:index": "node ../../scripts/build/upstream-ready.mjs ensure",
    "prenlp:eval-mechanical": "node ../../scripts/build/upstream-ready.mjs ensure",
    "prenlp:eval-sentence": "node ../../scripts/build/upstream-ready.mjs ensure",
    "prenlp:qa-score": "node ../../scripts/build/upstream-ready.mjs ensure",
    "prenlp:tune-dashboard": "node ../../scripts/build/upstream-ready.mjs ensure",
    "prenlp:tune-diff": "node ../../scripts/build/upstream-ready.mjs ensure",
    "prenlp:tune-sweep": "node ../../scripts/build/upstream-ready.mjs ensure",
    "pretypecheck": "node ../../scripts/build/upstream-ready.mjs ensure",
    "pretest": "node ../../scripts/build/upstream-ready.mjs ensure",
    "dev": "vite dev",
    "build": "vite build",
    "build:index": "tsx scripts/build-index.ts",
    "nlp:eval-mechanical": "tsx scripts/eval-mechanical.ts",
    "nlp:eval-sentence": "tsx scripts/eval-sentence.ts",
    "nlp:qa-score": "tsx scripts/qa-score.ts",
    "nlp:tune-dashboard": "tsx scripts/tune-dashboard.ts",
    "nlp:tune-diff": "tsx scripts/tune-diff.ts",
    "nlp:tune-sweep": "tsx scripts/tune-sweep.ts",
    "preview": "vite preview",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "typecheck:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "biome check --error-on-warnings --write .",
    "lint": "biome check --error-on-warnings .",
    "check": "pnpm typecheck && pnpm lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pack": "pnpm build"
  },
  "devDependencies": {
    "@carlwr/zsh-core": "workspace:*",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^22.20.3",
    "fast-check": "^4.10.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tslib": "^2.8.1",
    "tsx": "^4.23.13",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@carlwr/docopt-tmlanguage": "^0.1.2",
    "@carlwr/typescript-extra": "0.11.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@huggingface/transformers": "^4.3.0",
    "markdown-it": "^15.0.2",
    "shiki": "^3.23.0",
    "zod": "^4.6.5"
  }
}
