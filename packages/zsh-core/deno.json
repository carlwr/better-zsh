{
  "$schema": "https://jsr.io/schema/config-file.v1.json",
  "name": "@carlwr/zsh-core",
  "version": "0.1.0-alpha.2",
  "license": "MIT",
  "nodeModulesDir": "auto",
  "exports": {
    ".": "./index.ts",
    "./assets": "./assets.ts",
    "./meta": "./meta.ts",
    "./render": "./render.ts",
    "./resolver": "./resolver.ts"
  },
  "publish": {
    "include": [
      "LICENSE",
      "README.md",
      "THIRD_PARTY_NOTICES.md",
      "assets.ts",
      "index.ts",
      "meta.ts",
      "render.ts",
      "resolver.ts",
      "src/**/*.ts",
      "src/data/zsh-docs/**/*"
    ],
    "exclude": ["src/test/**/*"]
  },
  "lint": {
    "include": [
      "assets.ts",
      "index.ts",
      "meta.ts",
      "render.ts",
      "resolver.ts",
      "src/**/*.ts"
    ],
    "exclude": ["src/test/**/*.ts"]
  },
  "minimumDependencyAge": {
    "age": "P1D",
    "exclude": ["npm:@carlwr/typescript-extra"]
  }
}
