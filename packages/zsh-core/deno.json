{
  "$schema": "https://jsr.io/schema/config-file.v1.json",
  "name": "@carlwr/zsh-core",
  "version": "0.1.0-alpha.1",
  "license": "MIT",
  "nodeModulesDir": "auto",
  "exports": {
    ".": "./index.ts",
    "./analysis": "./analysis.ts",
    "./assets": "./assets.ts",
    "./meta": "./meta.ts",
    "./render": "./render.ts",
    "./resolver": "./resolver.ts",
    "./taxonomy": "./taxonomy.ts",
    "./types": "./types.ts"
  },
  "publish": {
    "include": [
      "LICENSE",
      "README.md",
      "THIRD_PARTY_NOTICES.md",
      "analysis.ts",
      "assets.ts",
      "index.ts",
      "meta.ts",
      "render.ts",
      "resolver.ts",
      "taxonomy.ts",
      "types.ts",
      "src/**/*.ts",
      "src/data/zsh-docs/**/*"
    ],
    "exclude": ["src/test/**/*"]
  },
  "lint": {
    "include": [
      "analysis.ts",
      "assets.ts",
      "index.ts",
      "meta.ts",
      "render.ts",
      "resolver.ts",
      "taxonomy.ts",
      "types.ts",
      "src/**/*.ts"
    ],
    "exclude": ["src/test/**/*.ts"]
  }
}
