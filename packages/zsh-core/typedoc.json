{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "./analysis.ts",
    "./assets.ts",
    "./index.ts",
    "./meta.ts",
    "./render.ts",
    "./resolver.ts",
    "./taxonomy.ts",
    "./types.ts"
  ],
  "entryPointStrategy": "resolve",
  "tsconfig": "./tsconfig.build.json",
  "out": "./.aux/docs/site/zsh-core",
  "json": "./.aux/docs/site/zsh-core/typedoc.json",
  "readme": "none",
  "sort": ["source-order"],
  "categorizeByGroup": false,
  "excludeReferences": true,
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeInternal": true,
  "navigation": {
    "excludeReferences": true
  },
  "githubPages": false,
  "treatWarningsAsErrors": true,
  "intentionallyNotExported": [
    "src/analysis/fact-types.ts:quoteStyles",
    "src/analysis/fact-types.ts:FactGuard",
    "src/docs/corpus.ts:DocMap",
    "src/docs/corpus.ts:SubKindEnums",
    "src/docs/resolver.ts:ResolverFeedbackKindSchemas",
    "src/docs/taxonomy.ts:SubKindFnMap",
    "src/render/refs.ts:RefDocK"
  ]
}
