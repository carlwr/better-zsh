{
  "name": "@carlwr/zsh-core",
  "description": "Structured zsh reference data parsed from official zsh documentation + analysis APIs",
  "version": "0.1.0-alpha.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/carlwr/better-zsh"
  },
  "main": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "deno.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./analysis": {
      "types": "./dist/types/analysis.d.ts",
      "import": "./dist/analysis.mjs",
      "require": "./dist/analysis.js",
      "default": "./dist/analysis.mjs"
    },
    "./assets": {
      "types": "./dist/types/assets.d.ts",
      "import": "./dist/assets.mjs",
      "require": "./dist/assets.js",
      "default": "./dist/assets.mjs"
    },
    "./exec": {
      "types": "./dist/types/exec.d.ts",
      "import": "./dist/exec.mjs",
      "require": "./dist/exec.js",
      "default": "./dist/exec.mjs"
    },
    "./meta": {
      "types": "./dist/types/meta.d.ts",
      "import": "./dist/meta.mjs",
      "require": "./dist/meta.js",
      "default": "./dist/meta.mjs"
    },
    "./render": {
      "types": "./dist/types/render.d.ts",
      "import": "./dist/render.mjs",
      "require": "./dist/render.js",
      "default": "./dist/render.mjs"
    },
    "./resolver": {
      "types": "./dist/types/resolver.d.ts",
      "import": "./dist/resolver.mjs",
      "require": "./dist/resolver.js",
      "default": "./dist/resolver.mjs"
    },
    "./taxonomy": {
      "types": "./dist/types/taxonomy.d.ts",
      "import": "./dist/taxonomy.mjs",
      "require": "./dist/taxonomy.js",
      "default": "./dist/taxonomy.mjs"
    },
    "./types": {
      "types": "./dist/types/types.d.ts",
      "import": "./dist/types.mjs",
      "require": "./dist/types.js",
      "default": "./dist/types.mjs"
    },
    "./data/*.json": "./dist/json/*.json",
    "./schema/*.json": "./dist/schema/*.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsx build.ts && node scripts/build-api.mjs && tsx scripts/build-schema.ts",
    "watch": "tsx build.ts --watch",
    "dump:refs": "tsx scripts/dump-refs.ts",
    "docs:typedoc:html": "typedoc",
    "docs:typedoc:json": "typedoc --emit none",
    "docs:api": "node scripts/build-api.mjs",
    "docs:build": "pnpm build && pnpm docs:typedoc:html && node scripts/build-docs.mjs",
    "jsrREGISTRY:dry": "pnpm dlx jsr publish --dry-run --allow-dirty",
    "jsrREGISTRY:check": "deno publish --dry-run --allow-dirty",
    "lint:slowtypes": "deno publish --dry-run --allow-dirty --no-check",
    "typecheck": "tsc --noEmit",
    "format": "biome check --error-on-warnings --write analysis.ts assets.ts build.ts deno.json exec.ts index.ts meta.ts render.ts resolver.ts taxonomy.ts types.ts scripts src tsconfig.build.json tsconfig.json typedoc.json vitest.config.ts package.json",
    "lint": "biome check --error-on-warnings analysis.ts assets.ts build.ts deno.json exec.ts index.ts meta.ts render.ts resolver.ts taxonomy.ts types.ts scripts src tsconfig.build.json tsconfig.json typedoc.json vitest.config.ts package.json",
    "check": "pnpm typecheck && pnpm lint",
    "test": "vitest run",
    "test:smoke": "pnpm build && tsx scripts/test-smoke.ts",
    "testREGISTRY:install": "pnpm build && node scripts/test-install.mjs",
    "test:integration": "pnpm run check && pnpm run test && pnpm run test:smoke",
    "verifyREGISTRY": "pnpm run testREGISTRY:install && pnpm run jsrREGISTRY:check"
  },
  "dependencies": {
    "@carlwr/typescript-extra": "0.9.0"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "ts-json-schema-generator": "^2.4.0",
    "vitest": "^4.1.4"
  }
}
