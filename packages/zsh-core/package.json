{
  "name": "@carlwr/zsh-core",
  "description": "Structured zsh reference data parsed from official zsh documentation",
  "version": "0.1.0-alpha.2",
  "license": "MIT",
  "author": {
    "name": "carlwr",
    "url": "https://github.com/carlwr"
  },
  "keywords": [
    "zsh",
    "shell",
    "documentation",
    "reference",
    "yodl",
    "parser"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carlwr/better-zsh.git",
    "directory": "packages/zsh-core"
  },
  "homepage": "https://github.com/carlwr/better-zsh/tree/main/packages/zsh-core#readme",
  "bugs": "https://github.com/carlwr/better-zsh/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/types/index.d.cts",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "!dist/*.d.mts",
    "!dist/*.d.cts",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.mjs"
    },
    "./assets": {
      "import": {
        "types": "./dist/types/assets.d.mts",
        "default": "./dist/assets.mjs"
      },
      "require": {
        "types": "./dist/types/assets.d.cts",
        "default": "./dist/assets.cjs"
      },
      "default": "./dist/assets.mjs"
    },
    "./meta": {
      "import": {
        "types": "./dist/types/meta.d.mts",
        "default": "./dist/meta.mjs"
      },
      "require": {
        "types": "./dist/types/meta.d.cts",
        "default": "./dist/meta.cjs"
      },
      "default": "./dist/meta.mjs"
    },
    "./render": {
      "import": {
        "types": "./dist/types/render.d.mts",
        "default": "./dist/render.mjs"
      },
      "require": {
        "types": "./dist/types/render.d.cts",
        "default": "./dist/render.cjs"
      },
      "default": "./dist/render.mjs"
    },
    "./resolver": {
      "import": {
        "types": "./dist/types/resolver.d.mts",
        "default": "./dist/resolver.mjs"
      },
      "require": {
        "types": "./dist/types/resolver.d.cts",
        "default": "./dist/resolver.cjs"
      },
      "default": "./dist/resolver.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ../../scripts/build/build-stamp.mjs clear && tsx build.ts && node scripts/build-api.mjs && node ../../scripts/build/build-stamp.mjs write",
    "dump:refs": "tsx scripts/dump-refs.ts",
    "pack:release": "tsx scripts/pack-release.ts",
    "docs:typedoc:html": "typedoc",
    "docs:api": "node scripts/build-api.mjs",
    "docs:build": "pnpm build && pnpm docs:typedoc:html && node scripts/build-docs.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.build.json --declaration --isolatedDeclarations",
    "format": "biome check --error-on-warnings --write .",
    "lint": "biome check --error-on-warnings .",
    "check": "pnpm typecheck && pnpm lint",
    "test": "vitest run",
    "test:pack": "pnpm build && tsx scripts/test-pack.ts && pnpm pack:release",
    "testREGISTRY:install": "pnpm build && node scripts/test-install.mjs",
    "test:integration": "pnpm run check && pnpm run test && pnpm run test:pack",
    "release:act": "ACT_WORKFLOW=release-zsh-core.yml ACT_JOB=publish ACT_EVENT=workflow_dispatch ../../scripts/test-integration-act --input dry_run=true",
    "verifyREGISTRY": "pnpm run testREGISTRY:install"
  },
  "dependencies": {
    "@carlwr/typescript-extra": "catalog:"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@carlwr/fastcheck-utils": "catalog:",
    "@microsoft/api-extractor": "^7.59.2",
    "@types/node": "catalog:",
    "ajv": "^8.20.0",
    "fast-check": "catalog:",
    "publint": "^0.3.24",
    "ts-json-schema-generator": "^2.9.0",
    "tsdown": "catalog:",
    "tsx": "catalog:",
    "typedoc": "^0.28.20",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
