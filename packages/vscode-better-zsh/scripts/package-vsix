#!/usr/bin/env sh

# Caller is responsible for having built the extension + upstream deps.
# Aggregator scripts (`vsix`, `test:smoke`, `testINTERACTIVE:electron-bundled`,
# `vscode:publish*`, `ovsx:publish*`) run `pnpm build` before invoking this
# script; the leading build triggers the `prebuild` hook that builds
# upstream packages.

set -eu

pkg_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
repo_root=$(CDPATH= cd -- "$pkg_dir/../.." && pwd)
stage=$repo_root/.non-vcs/vscode-better-zsh-extension
out=${1:-better-zsh.vsix}

if [ "${1:-}" = -- ]; then
	shift
	out=${1:-better-zsh.vsix}
fi

case $out in
	/*) abs_out=$out ;;
	*) abs_out=$pkg_dir/$out ;;
esac

node "$pkg_dir/scripts/check-package.mjs"
(cd "$stage" && "$repo_root/node_modules/.bin/vsce" package --no-dependencies --out "$abs_out")
