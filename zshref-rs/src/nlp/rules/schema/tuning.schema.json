{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tuning",
  "description": "Rank-time scalar constants for the ranker (no re-embed on change).\nSerialized downstream for non-Rust rankers.",
  "type": "object",
  "properties": {
    "semantic_weights": {
      "$ref": "#/$defs/SemanticWeights"
    },
    "boosts": {
      "$ref": "#/$defs/BoostWeights"
    },
    "penalties": {
      "$ref": "#/$defs/PenaltyWeights"
    },
    "lexical": {
      "$ref": "#/$defs/LexicalThresholds"
    }
  },
  "additionalProperties": false,
  "required": [
    "semantic_weights",
    "boosts",
    "penalties",
    "lexical"
  ],
  "$defs": {
    "SemanticWeights": {
      "type": "object",
      "properties": {
        "body": {
          "description": "Mix over the embedding views. Only these two are stored; `expanded` is\nderived as `1 − body − structured` (on the simplex by construction).\nSee `rank::semantic_weights`.",
          "type": "number",
          "format": "float"
        },
        "structured": {
          "type": "number",
          "format": "float"
        },
        "short_body": {
          "$ref": "#/$defs/ShortBodyDeform"
        }
      },
      "additionalProperties": false,
      "required": [
        "body",
        "structured",
        "short_body"
      ]
    },
    "ShortBodyDeform": {
      "description": "Sparse-body deformation: shifts mass body → expanded as a body shortens, so\nshort records lean on structured/expanded text. See `rank::semantic_weights`.",
      "type": "object",
      "properties": {
        "strength": {
          "description": "Max shift, at body length 0.",
          "type": "number",
          "format": "float"
        },
        "length_scale": {
          "description": "Body length at/above which the shift is zero.",
          "type": "number",
          "format": "float"
        }
      },
      "additionalProperties": false,
      "required": [
        "strength",
        "length_scale"
      ]
    },
    "BoostWeights": {
      "type": "object",
      "properties": {
        "category": {
          "description": "Weakest signal: query names the record's category.",
          "type": "number",
          "format": "float"
        },
        "exact_word_increment": {
          "description": "Non-negative increment for a query word equal to id/display\n(`exact_word = category + this`).",
          "type": "number",
          "format": "float"
        },
        "resolver_increment": {
          "description": "Non-negative increment for a corpus-aware resolver hit\n(`resolver = exact_word + this`); the increments keep\n`category ≤ exact_word ≤ resolver` by construction.",
          "type": "number",
          "format": "float"
        },
        "word_overlap": {
          "$ref": "#/$defs/WordOverlap"
        }
      },
      "additionalProperties": false,
      "required": [
        "category",
        "exact_word_increment",
        "resolver_increment",
        "word_overlap"
      ]
    },
    "WordOverlap": {
      "description": "Smooth saturating overlap boost; see `rank::overlap_boost`.",
      "type": "object",
      "properties": {
        "scale": {
          "type": "number",
          "format": "float"
        },
        "half_sat": {
          "type": "number",
          "format": "float"
        }
      },
      "additionalProperties": false,
      "required": [
        "scale",
        "half_sat"
      ]
    },
    "PenaltyWeights": {
      "type": "object",
      "properties": {
        "category_rarity_max": {
          "type": "number",
          "format": "float"
        }
      },
      "additionalProperties": false,
      "required": [
        "category_rarity_max"
      ]
    },
    "LexicalThresholds": {
      "type": "object",
      "properties": {
        "min_discriminating_word_len": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "min_significant_word_len": {
          "type": "integer",
          "format": "uint",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "min_discriminating_word_len",
        "min_significant_word_len"
      ]
    }
  }
}
