#!/usr/bin/env zsh
# Regenerate THIRD_PARTY_NOTICES.md: every crate linked into either binary,
# grouped by license — the union over the triples tests/msrv.rs guards.
emulate -LR zsh
set -eu -o pipefail

crate=${0:A:h:h}
out=$crate/THIRD_PARTY_NOTICES.md
triples=(
  aarch64-apple-darwin
  x86_64-apple-darwin
  x86_64-unknown-linux-gnu
  aarch64-unknown-linux-gnu
  x86_64-pc-windows-msvc
)

# one "name version<TAB>license" per crate; build-only, dev and proc-macro
# deps excluded — they never reach the binaries
lines=()
for t in $triples
  lines+=( "${(@f)$(cd $crate && cargo tree -e normal,no-proc-macro --all-features \
                      --target $t --prefix none --format $'{p}\t{l}' \
                      | sed -E 's/ v([0-9])/ \1/; s/ \(.*\)//')}" )
lines=( ${(u)lines} )
lines=( ${lines:#zshref *} )

{
  print -- 'Crates linked into the compiled `zshref` and `zshref-mcp` binaries. Build-time'
  print -- 'tooling (rustc, cargo) is not covered here. Vendored zsh upstream documentation'
  print -- 'notices are in the repo-root `THIRD_PARTY_NOTICES.md`.'
  print
  print -- 'Generated by `scripts/third-party-notices`; regenerate when `Cargo.lock` moves.'
  print
  print -- '---'
  for lic in ${(uo)${lines#*$'\t'}}
  do
    print
    print -- "## $lic"
    print
    print -l -- ${(o)${(M)lines:#*$'\t'$lic}%%$'\t'*} | sed 's/^/- /'
  done
} > $out
print -u2 -- "wrote $out (${#lines} crates)"
