#!/usr/bin/env node
// capture-mcp <label> <server-command...>: one MCP stdio session against
// the given server command — initialize, tools/list, then tools/call per
// line of .aux/resolver-fixture/pinned.jsonl — recorded under
// .aux/mcp-rust/<label>/ for before/after diffing (run from the repo root).
//
// Normalisation, so the TS and Rust servers diff on protocol shape only:
//   - keys sorted recursively
//   - tools/call rows: every `score` stripped; `content[0].text` replaced by
//     its parsed JSON value

import { spawn } from "node:child_process"
import { mkdirSync, readFileSync, writeFileSync } from "node:fs"
import { createInterface } from "node:readline"

const [label, cmd, ...args] = process.argv.slice(2)
if (!label || !cmd) {
  console.error("usage: capture-mcp <label> <server-command...>")
  process.exit(2)
}
const pinned = readFileSync(".aux/resolver-fixture/pinned.jsonl", "utf8")
  .split("\n")
  .filter(l => l.trim())
  .map(l => JSON.parse(l))
const outDir = `.aux/mcp-rust/${label}`
mkdirSync(outDir, { recursive: true })

const child = spawn(cmd, args, { stdio: ["pipe", "pipe", "inherit"] })
const lines = createInterface({ input: child.stdout })
const pending = new Map()
lines.on("line", line => {
  const msg = JSON.parse(line)
  if (msg.id === undefined) return
  const p = pending.get(msg.id)
  pending.delete(msg.id)
  if ("error" in msg) p.resolve({ error: msg.error })
  else p.resolve(msg.result)
})
let nextId = 1
const request = (method, params) =>
  new Promise(resolve => {
    const id = nextId++
    pending.set(id, { resolve })
    child.stdin.write(`${JSON.stringify({ jsonrpc: "2.0", id, method, params })}\n`)
  })
const notify = (method, params) =>
  child.stdin.write(`${JSON.stringify({ jsonrpc: "2.0", method, params })}\n`)

const sortKeys = v =>
  Array.isArray(v)
    ? v.map(sortKeys)
    : v && typeof v === "object"
      ? Object.fromEntries(
          Object.keys(v)
            .sort()
            .map(k => [k, sortKeys(v[k])]),
        )
      : v
const stripScores = v =>
  Array.isArray(v)
    ? v.map(stripScores)
    : v && typeof v === "object"
      ? Object.fromEntries(
          Object.entries(v)
            .filter(([k]) => k !== "score")
            .map(([k, x]) => [k, stripScores(x)]),
        )
      : v
const normaliseCall = result => {
  const r = stripScores(result)
  const text = r.content?.[0]?.text
  if (typeof text === "string") {
    try {
      r.content[0].text = JSON.parse(text)
    } catch {}
  }
  return r
}
const pretty = v => `${JSON.stringify(sortKeys(v), null, 2)}\n`

const init = await request("initialize", {
  protocolVersion: "2025-06-18",
  capabilities: {},
  clientInfo: { name: "capture-mcp", version: "0" },
})
notify("notifications/initialized", {})
writeFileSync(`${outDir}/initialize.json`, pretty(init))
writeFileSync(`${outDir}/tools-list.json`, pretty(await request("tools/list", {})))
const rows = []
for (const { tool, input } of pinned) {
  const result = await request("tools/call", { name: tool, arguments: input })
  rows.push(JSON.stringify(sortKeys({ tool, input, result: normaliseCall(result) })))
}
writeFileSync(`${outDir}/tools-call.jsonl`, `${rows.join("\n")}\n`)
child.stdin.end()
const code = await new Promise(resolve => child.on("close", resolve))
console.error(`captured -> ${outDir} (server exit ${code})`)
process.exit(code === 0 ? 0 : 1)
