{
  "name": "zshref-web",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Static SPA: NLP search demo over zsh-core records (consumes zshref release artifacts).",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/quiet-run.mjs build vite build",
    "preview": "vite preview",
    "check": "node scripts/quiet-run.mjs check pnpm --silent check:run",
    "check:run": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "node scripts/quiet-run.mjs lint biome lint .",
    "test": "node scripts/quiet-run.mjs test vitest run",
    "test:watch": "vitest",
    "qa": "pnpm check && pnpm lint && pnpm test && pnpm build",
    "run:verbose": "node scripts/quiet-run.mjs --verbose"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^22.20.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "@carlwr/docopt-tmlanguage": "^0.1.2",
    "@carlwr/typescript-extra": "0.11.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@huggingface/transformers": "^4.2.0",
    "markdown-it": "^15.0.1",
    "shiki": "^3.23.0",
    "zod": "^4.5.4"
  }
}
