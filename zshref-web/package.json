{
  "name": "zshref-web",
  "version": "0.1.0-alpha.0",
  "private": true,
  "type": "module",
  "description": "Static SPA: NLP search demo over zsh-core records (consumes zshref release artifacts).",
  "license": "MIT",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "vite dev",
    "build": "node scripts/quiet-run.mjs build vite build",
    "preview": "vite preview",
    "check": "node scripts/quiet-run.mjs check pnpm -s check:run",
    "check:run": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "node scripts/quiet-run.mjs lint biome lint .",
    "test": "node scripts/quiet-run.mjs test vitest run",
    "test:watch": "vitest",
    "qa": "pnpm check && pnpm lint && pnpm test && pnpm build",
    "run:verbose": "node scripts/quiet-run.mjs --verbose"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@sveltejs/adapter-static": "^3.0.5",
    "@sveltejs/kit": "^2.8.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tslib": "^2.8.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "yaml": "^2.6.0"
  },
  "dependencies": {
    "@carlwr/docopt-tmlanguage": "^0.1.1",
    "@carlwr/typescript-extra": "0.11.0",
    "@fontsource-variable/inter": "^5.1.0",
    "@fontsource-variable/jetbrains-mono": "^5.1.0",
    "@huggingface/transformers": "^3.0.0",
    "markdown-it": "^14.1.0",
    "shiki": "^1.24.0",
    "zod": "^3.23.0"
  }
}
