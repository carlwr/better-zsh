{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  // Lints the .ts logic only. .svelte components are checked by svelte-check
  // (template-aware); Biome parses <script> in isolation and would
  // false-flag template-referenced symbols as unused. Formatter is off —
  // this package keeps its semicolon style, so Biome is the lint-discipline
  // match with the workspace root, not a formatter. Rule set mirrors the
  // root biome.jsonc.
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["src/**/*.ts", "tests/**/*.ts", "*.ts", "!**/*.d.ts"]
  },
  "formatter": {
    "enabled": false
  },
  "linter": {
    "rules": {
      "complexity": {
        "noCommaOperator": "off"
      },
      "suspicious": {
        "noTemplateCurlyInString": "off"
      }
    }
  }
}
