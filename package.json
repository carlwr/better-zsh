{
  "name": "better-zsh-workspace",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "packageManager": "pnpm@10.23.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/carlwr/better-zsh"
  },
  "scripts": {
    "build": "node scripts/build/quiet-run.mjs build",
    "watch": "pnpm --filter better-zsh watch",
    "format": "node scripts/build/quiet-run.mjs format",
    "format:root": "biome check --error-on-warnings --write scripts package.json",
    "format:check": "node scripts/build/quiet-run.mjs format:check",
    "lint": "node scripts/build/quiet-run.mjs lint",
    "lint:root": "biome check --error-on-warnings scripts package.json",
    "lint:symlinks": "scripts/list-repo-symlinks --quiet && scripts/check-claude-md-pairs --quiet",
    "lint:md": "scripts/list-maintainer-docs --quiet",
    "verify:upstream": "node scripts/build/verify-upstream-contract.mjs",
    "bootstrap:upstream": "node scripts/build/upstream-ready.mjs bootstrap",
    "run:verbose": "node scripts/build/quiet-run.mjs --verbose",
    "typecheck": "node scripts/build/quiet-run.mjs typecheck",
    "check": "node scripts/build/quiet-run.mjs check",
    "test": "node scripts/build/quiet-run.mjs test",
    "test:unit": "node scripts/build/quiet-run.mjs test:unit",
    "test:scripts": "node scripts/build/quiet-run.mjs test:scripts",
    "qa": "node scripts/build/quiet-run.mjs qa",
    "qa:verbose": "pnpm run:verbose qa",
    "test:integration": "node scripts/build/quiet-run.mjs test:integration",
    "dump:refs": "pnpm --filter @carlwr/zsh-core dump:refs",
    "testINTERACTIVE": "pnpm run testINTERACTIVE:electron && pnpm run testINTERACTIVE:electron-bundled",
    "testINTERACTIVE:electron": "pnpm --filter better-zsh testINTERACTIVE:electron",
    "testINTERACTIVE:electron-bundled": "pnpm --filter better-zsh testINTERACTIVE:electron-bundled",
    "vsix": "node scripts/build/quiet-run.mjs vsix",
    "test:smoke": "node scripts/build/quiet-run.mjs test:smoke",
    "docs:zsh-core": "pnpm --filter @carlwr/zsh-core docs:build",
    "jsrREGISTRY:zsh-core:dry": "pnpm --filter @carlwr/zsh-core jsrREGISTRY:dry",
    "jsrREGISTRY:zsh-core:check": "pnpm --filter @carlwr/zsh-core jsrREGISTRY:check",
    "jsrREGISTRY:tooldef:dry": "pnpm --filter @carlwr/zsh-core-tooldef jsrREGISTRY:dry",
    "jsrREGISTRY:tooldef:check": "pnpm --filter @carlwr/zsh-core-tooldef jsrREGISTRY:check",
    "jsrREGISTRY:mcp:dry": "pnpm --filter @carlwr/zshref-mcp jsrREGISTRY:dry",
    "jsrREGISTRY:mcp:check": "pnpm --filter @carlwr/zshref-mcp jsrREGISTRY:check",
    "jsrREGISTRY:check": "pnpm --filter @carlwr/zsh-core jsrREGISTRY:check && pnpm --filter @carlwr/zsh-core-tooldef jsrREGISTRY:check && pnpm --filter @carlwr/zshref-mcp jsrREGISTRY:check",
    "vscode:publish:dry": "pnpm --filter better-zsh vscode:publish:dry",
    "vscode:publish": "pnpm --filter better-zsh vscode:publish",
    "ovsx:publish:dry": "pnpm --filter better-zsh ovsx:publish:dry",
    "ovsx:publish": "pnpm --filter better-zsh ovsx:publish",
    "cli": "node scripts/build/quiet-run.mjs cli",
    "cli:debug": "node scripts/build/quiet-run.mjs cli:debug",
    "cli:test": "node scripts/build/quiet-run.mjs cli:test",
    "cli:check": "node scripts/build/quiet-run.mjs cli:check"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@carlwr/fastcheck-utils": "^0.5.1",
    "@carlwr/typescript-extra": "0.9.0",
    "@fast-check/vitest": "^0.4.0",
    "@microsoft/api-extractor": "^7.58.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.0",
    "@types/vscode": "1.116.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.9.1",
    "fast-check": "^4.7.0",
    "jsonc-parser": "^3.3.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typedoc": "^0.28.19",
    "typescript": "^5.8.0",
    "vitest": "^4.1.4",
    "zod": "^4.3.6",
    "zzz_LAST_dummy": "npm:empty-npm-package@1.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@vscode/vsce-sign",
      "esbuild",
      "keytar"
    ]
  }
}
