{
  "name": "zsh-lexicon-workspace",
  "private": true,
  "version": "0.0.1",
  "license": "MIT",
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
  "repository": {
    "type": "git",
    "url": "https://github.com/carlwr/zsh-lexicon"
  },
  "scripts": {
    "build": "node scripts/build/quiet-run.mjs build",
    "format": "node scripts/build/quiet-run.mjs format",
    "format:root": "biome check --error-on-warnings --write scripts package.json zshref-rs/npm",
    "lint": "node scripts/build/quiet-run.mjs lint",
    "lint:root": "biome check --error-on-warnings scripts package.json zshref-rs/npm",
    "lint:symlinks": "scripts/list-repo-symlinks --quiet && scripts/check-claude-md-pairs --quiet",
    "lint:md": "scripts/list-maintainer-docs --quiet",
    "bootstrap:upstream": "node scripts/build/upstream-ready.mjs bootstrap",
    "run:verbose": "node scripts/build/quiet-run.mjs --verbose",
    "typecheck": "node scripts/build/quiet-run.mjs typecheck",
    "check": "node scripts/build/quiet-run.mjs check",
    "test": "node scripts/build/quiet-run.mjs test",
    "test:unit": "node scripts/build/quiet-run.mjs test:unit",
    "test:scripts": "node scripts/build/quiet-run.mjs test:scripts",
    "qa": "node scripts/build/quiet-run.mjs qa",
    "qa:verbose": "pnpm run:verbose qa",
    "test:integration": "node scripts/build/quiet-run.mjs test:integration",
    "dump:refs": "pnpm --filter @carlwr/zsh-lexicon dump:refs",
    "testINTERACTIVE": "pnpm run testINTERACTIVE:electron && pnpm run testINTERACTIVE:electron-bundled",
    "testINTERACTIVE:electron": "pnpm --filter better-zsh testINTERACTIVE:electron",
    "testINTERACTIVE:electron-bundled": "pnpm --filter better-zsh testINTERACTIVE:electron-bundled",
    "vsix": "node scripts/build/quiet-run.mjs vsix",
    "test:pack": "node scripts/build/quiet-run.mjs test:pack",
    "docs:zsh-lexicon": "pnpm --filter @carlwr/zsh-lexicon docs:build",
    "vscode:publish:dry": "pnpm --filter better-zsh vscode:publish:dry",
    "cli": "node scripts/build/quiet-run.mjs cli",
    "cli:debug": "node scripts/build/quiet-run.mjs cli:debug",
    "cli:test": "node scripts/build/quiet-run.mjs cli:test",
    "cli:check": "node scripts/build/quiet-run.mjs cli:check",
    "cli:qa": "node scripts/build/quiet-run.mjs cli:qa"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@carlwr/fastcheck-utils": "catalog:",
    "@carlwr/typescript-extra": "catalog:",
    "typescript": "catalog:",
    "yaml": "catalog:",
    "zzz_LAST_dummy": "npm:empty-npm-package@1.0.0"
  }
}
