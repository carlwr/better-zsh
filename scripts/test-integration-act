#!/usr/bin/env zsh
# Run one CI workflow job locally through `act`. Knobs: the ACT_* variables
# below; further `act` flags pass through after `--`.

emulate -L zsh
setopt errexit nounset pipefail

# run from repo root regardless of caller cwd (pnpm runs package scripts in the package dir)
cd ${0:A:h}/..

wf=.github/workflows/${ACT_WORKFLOW:-ci.yml}
# a manual-dispatch-only job also needs ACT_EVENT=workflow_dispatch
job=${ACT_JOB:-integration}
# what `ubuntu-latest` maps to: act's documented medium image
img=${ACT_RUNNER_IMAGE:-catthehacker/ubuntu:act-latest}

die() { print -u2 -r -- "$@"; exit 1; }

have() { command -v "$1" >/dev/null 2>&1 }

[[ -f $wf ]] || die "missing workflow $wf"
have act || die "missing act"
have docker || die "missing docker"

if ! docker info >/dev/null 2>&1; then
	if [[ $(uname -s) == Darwin ]] && have colima; then
		die "docker unavailable; start colima or another docker-compatible engine reachable via docker"
	fi
	die "docker unavailable; start a docker-compatible engine reachable via docker"
fi

if [[ ${1:-} == -- ]]; then
	shift
fi

# Apple Silicon: match the local runtime and skip act's architecture warning;
# linux/amd64 when GitHub-hosted fidelity matters more than speed or stability.
arch=${ACT_CONTAINER_ARCHITECTURE:-}
if [[ -z $arch && $(uname -s) == Darwin && $(uname -m) == arm64 ]]; then
	arch=linux/arm64
fi

args=()
if [[ -n ${ACT_EVENT:-} ]]; then
	args+=($ACT_EVENT)
fi
args+=(
	--workflows
	$wf
	--job
	$job
	--platform
	ubuntu-latest=$img
	--container-daemon-socket
	-
)

if [[ -n $arch ]]; then
	args+=(--container-architecture $arch)
fi

exec act "${args[@]}" "$@"
