{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      // Vendored grammar + byte-exact fixtures, both under packages/ — `**/`
      // since a bare name anchors to this dir, where neither exists.
      "!**/syntaxes",
      "!**/test-fixtures",
      // Rust crate: drift-checked JSON under it must not be reformatted by a
      // bare root run / the LSP.
      "!zshref-rs"
    ]
  },
  "formatter": {
    "useEditorconfig": true
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "arrowParentheses": "asNeeded"
    }
  },
  "linter": {
    "rules": {
      "complexity": {
        "noCommaOperator": "off"
      },
      "suspicious": {
        // zsh code embedded in strings uses ${...} extensively
        "noTemplateCurlyInString": "off"
      }
    }
  }
}
