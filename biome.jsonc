{
  "$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      // Vendored grammar + byte-exact fixtures, both under packages/ — `**/`
      // since a bare name anchors to this dir, where neither exists.
      "!**/syntaxes",
      "!**/test-fixtures",
      // Sibling projects, not workspace members — each owns its tooling
      // (zshref-web: own Biome root; zshref-rs: Rust + drift-checked JSON).
      // Excluded so a bare root run / LSP won't hit the nested root or
      // reformat that JSON.
      "!zshref-web",
      "!zshref-rs"
    ]
  },
  "formatter": {
    "useEditorconfig": true
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded",
      "arrowParentheses": "asNeeded"
    }
  },
  "linter": {
    "rules": {
      "complexity": {
        "noCommaOperator": "off"
      },
      "suspicious": {
        // zsh code embedded in strings uses ${...} extensively
        "noTemplateCurlyInString": "off"
      }
    }
  }
}
